@baseUrl = https://ussd-app-bay.vercel.app/

### 1) Root USSD menu
POST {{baseUrl}}/ussd
Content-Type: application/json

{
  "sessionId": "session-root",
  "serviceCode": "*123#",
  "phoneNumber": "+265881234567",
  "text": ""
}

### 2) Check market prices
POST {{baseUrl}}/ussd
Content-Type: application/json

{
  "sessionId": "session-prices",
  "serviceCode": "*123#",
  "phoneNumber": "+265881234567",
  "text": "1"
}

### 3) Select a hub for market prices
POST {{baseUrl}}/ussd
Content-Type: application/json

{
  "sessionId": "session-prices",
  "serviceCode": "*123#",
  "phoneNumber": "+265881234567",
  "text": "1*2"
}

### 4) Start selling produce
POST {{baseUrl}}/ussd
Content-Type: application/json

{
  "sessionId": "session-sale",
  "serviceCode": "*123#",
  "phoneNumber": "+265991234567",
  "text": "2"
}

### 5) Choose crop
POST {{baseUrl}}/ussd
Content-Type: application/json

{
  "sessionId": "session-sale",
  "serviceCode": "*123#",
  "phoneNumber": "+265991234567",
  "text": "2*1"
}

### 6) Choose region
POST {{baseUrl}}/ussd
Content-Type: application/json

{
  "sessionId": "session-sale",
  "serviceCode": "*123#",
  "phoneNumber": "+265991234567",
  "text": "2*1*2"
}

### 7) Enter quantity
POST {{baseUrl}}/ussd
Content-Type: application/json

{
  "sessionId": "session-sale",
  "serviceCode": "*123#",
  "phoneNumber": "+265991234567",
  "text": "2*1*2*5"
}

### 8) Confirm sale submission
POST {{baseUrl}}/ussd
Content-Type: application/json

{
  "sessionId": "session-sale",
  "serviceCode": "*123#",
  "phoneNumber": "+265991234567",
  "text": "2*1*2*5*1"
}
